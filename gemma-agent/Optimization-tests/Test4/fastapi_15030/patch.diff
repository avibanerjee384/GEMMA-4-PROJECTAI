+class SSEResponse(StreamingResponse):
+    \"\"\"SSE response for Server-Sent Events.
+
+    This response sets the correct headers for SSE: `text/event-stream`, `no-cache`, `keep-alive`, and `X-Accel-Buffering: no`.
+    \"\"\"
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        headers["X-Accel-Buffering"] = "no"
+        super().__init__(
+            content, status_code=status_code, headers=headers, background=background, media_type=media_type
+        )
+
+
