@@ -0,0 +1,34 @@
+
+import requests
+from requests.models import PreparedRequest
+
+class FileWrapper:
+    def __init__(self):
+        self.read_called = False
+    def __getattr__(self, name):
+        if name == 'read':
+            def read_impl(length=None):
+                self.read_called = True
+                return b'content'
+            return read_impl
+        raise AttributeError(name)
+
+def test_encode_files_with_getattr_wrapper():
+    wrapper = FileWrapper()
+    files = {'file': wrapper}
+    pr = PreparedRequest()
+    body, content_type = pr._encode_files(files, None)
+    
+    print(f"Read called: {wrapper.read_called}")
+    assert wrapper.read_called
+    assert b'content' in body
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_encode_files_with_getattr_wrapper()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
